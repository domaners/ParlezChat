CREATE TABLE learner_profile (
    id              INTEGER PRIMARY KEY AUTOINCREMENT,
    native_language TEXT NOT NULL,
    target_language TEXT NOT NULL,
    interests       TEXT NOT NULL,          -- JSON array via column adapter
    level           TEXT NOT NULL,          -- ProficiencyLevel.name
    study_duration  TEXT NOT NULL,          -- StudyDuration.name
    is_active       INTEGER NOT NULL DEFAULT 0,
    created_at      INTEGER NOT NULL,
    updated_at      INTEGER NOT NULL,
    UNIQUE (native_language, target_language)
);

selectAll:
SELECT * FROM learner_profile;

selectActive:
SELECT * FROM learner_profile WHERE is_active = 1 LIMIT 1;

selectById:
SELECT * FROM learner_profile WHERE id = ?;

insert:
INSERT INTO learner_profile (native_language, target_language, interests, level, study_duration, is_active, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

setActive:
UPDATE learner_profile SET is_active = ?, updated_at = ? WHERE id = ?;

clearAllActive:
UPDATE learner_profile SET is_active = 0;

updateProfile:
UPDATE learner_profile SET native_language = ?, interests = ?, level = ?, study_duration = ?, updated_at = ? WHERE id = ?;

delete:
DELETE FROM learner_profile WHERE id = ?;

lastInsertRowId:
SELECT last_insert_rowid();
