CREATE TABLE api_error_log (
    id         INTEGER PRIMARY KEY AUTOINCREMENT,
    error_type TEXT NOT NULL,   -- ClaudeError subclass name, e.g. "RateLimited"
    message    TEXT NOT NULL,   -- human-readable description
    created_at INTEGER NOT NULL -- epoch milliseconds UTC
);

CREATE INDEX api_error_log_created ON api_error_log (created_at DESC);

selectAll:
SELECT * FROM api_error_log ORDER BY created_at DESC;

insert:
INSERT INTO api_error_log (error_type, message, created_at) VALUES (?, ?, ?);

deleteAll:
DELETE FROM api_error_log;
