CREATE TABLE vocab_entry (
    id                INTEGER PRIMARY KEY AUTOINCREMENT,
    profile_id        INTEGER NOT NULL REFERENCES learner_profile(id) ON DELETE CASCADE,
    term              TEXT NOT NULL COLLATE NOCASE,
    part_of_speech    TEXT,
    definition        TEXT NOT NULL,
    example_target    TEXT NOT NULL,
    example_native    TEXT NOT NULL,
    source_message_id INTEGER REFERENCES message(id) ON DELETE SET NULL,
    created_at        INTEGER NOT NULL,
    correct_count     INTEGER NOT NULL DEFAULT 0,
    incorrect_count   INTEGER NOT NULL DEFAULT 0,
    UNIQUE (profile_id, term)
);

selectByProfile:
SELECT * FROM vocab_entry WHERE profile_id = ? ORDER BY created_at DESC;

selectByTerm:
SELECT * FROM vocab_entry WHERE profile_id = ? AND term = ? COLLATE NOCASE LIMIT 1;

searchByProfile:
SELECT * FROM vocab_entry WHERE profile_id = ? AND (term LIKE :query OR definition LIKE :query) ORDER BY created_at DESC;

countByProfile:
SELECT COUNT(*) FROM vocab_entry WHERE profile_id = ?;

selectRandomForReview:
SELECT * FROM vocab_entry WHERE profile_id = ? ORDER BY RANDOM() LIMIT 1;

selectRandomDefinitions:
SELECT definition FROM vocab_entry
WHERE profile_id = ? AND id != ?
ORDER BY RANDOM()
LIMIT ?;

incrementCorrect:
UPDATE vocab_entry SET correct_count = correct_count + 1 WHERE id = ?;

incrementIncorrect:
UPDATE vocab_entry SET incorrect_count = incorrect_count + 1 WHERE id = ?;

insert:
INSERT INTO vocab_entry (profile_id, term, part_of_speech, definition, example_target, example_native, source_message_id, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

delete:
DELETE FROM vocab_entry WHERE id = ?;

lastInsertRowId:
SELECT last_insert_rowid();
